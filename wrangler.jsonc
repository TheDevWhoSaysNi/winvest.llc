{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winvest-llc",
  // Workers static assets is Cloudflare's current path for new sites
  // (Pages still works; new work should land here).
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
